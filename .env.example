# Copy to ".env" next to docker-compose.yml. .env is git-ignored.

DB_PASSWORD=irctc_root

# Required. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional: leave blank and OTPs / links are printed in the backend logs
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional integrations
STRIPE_SECRET_KEY=
RAPIDAPI_KEY=
GEMINI_API_KEY=
