# Copy this file to ".env" (same folder as pom.xml) and fill in your values.
# .env is git-ignored. Spring Boot reads it automatically at startup.

DB_URL=jdbc:mysql://localhost:3306/irctc?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Kolkata
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Gmail: use an App Password (Google Account > Security > App passwords)
# Leave blank in development: OTPs and links are then printed to the console instead.
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional integrations (features show a friendly message when blank)
STRIPE_SECRET_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=irctc-api2.p.rapidapi.com
GEMINI_API_KEY=
